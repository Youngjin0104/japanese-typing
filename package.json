{
  "name": "japanese-typing-app",
  "version": "1.0.0",
  "main": "App.jsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "assets": "node scripts/generate-assets.js",
    "fonts": "node scripts/download-fonts.js",
    "setup": "npm install && node scripts/download-fonts.js && node scripts/generate-assets.js",
    "build:dev": "eas build --platform android --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "build:prod": "eas build --platform android --profile production",
    "submit": "eas submit --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "^49.0.23",
    "expo-build-properties": "~0.12.5",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-splash-screen": "^55.0.20",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "^0.85.3",
    "react-native-google-mobile-ads": "^12.4.0",
    "react-native-iap": "12.15.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.34.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "sharp": "^0.33.4",
    "typescript": "^5.3.0"
  },
  "private": true
}
